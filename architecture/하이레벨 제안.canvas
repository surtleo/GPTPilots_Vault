{
	"nodes":[
		{"id":"5050a6b4d31e33e8","type":"group","x":-1500,"y":1140,"width":735,"height":820,"label":"온라인 쿼리 파이프라인"},
		{"id":"df46c40abeb69e45","type":"group","x":-2060,"y":500,"width":440,"height":1235,"label":"LangSmith"},
		{"id":"8fd80339eb5b8127","type":"group","x":-240,"y":-100,"width":771,"height":660,"label":"1. 추출"},
		{"id":"d16ab5180bdb58c8","type":"group","x":-680,"y":760,"width":530,"height":500,"label":"3. 청킹"},
		{"id":"76ebf73476489f6e","type":"group","x":-880,"y":400,"width":600,"height":290,"label":"2. 전처리"},
		{
			"id":"62f73d35a8eaf1a3",
			"type":"text",
			"text":"<정량 검증 게이트>\n추출량 , 표 보존, 문장 완결",
			"styleAttributes":{"shape":"diamond","textAlign":"center"},
			"x":-60,
			"y":180,
			"width":255,
			"height":160
		},
		{"id":"897ca0b685b02faf","type":"text","text":"<HWP 96개>\nhwp-hwpx-parser","x":-211,"y":-80,"width":250,"height":60},
		{"id":"0a97e0001b2e5252","type":"text","text":"<PDF 4개>\npymupdf4llm","x":140,"y":-80,"width":250,"height":60},
		{
			"id":"fb3cb0138a307c5a",
			"type":"text",
			"text":"사용자 질문 (+ 히스토리)",
			"styleAttributes":{},
			"x":-1300,
			"y":1160,
			"width":260,
			"height":60
		},
		{
			"id":"3eb43e53e463602c",
			"type":"text",
			"text":"<기관명 RapidFuzz 매칭>\n표준 사전 기반, LLM 호출 없음",
			"styleAttributes":{},
			"x":-1300,
			"y":1340,
			"width":260,
			"height":60
		},
		{
			"id":"83bde60f02da76d7",
			"type":"text",
			"text":"<골든셋 20~30문항>\nLLM-as-judge 표 질의 정답률 < 50% -> 파서 재검토",
			"styleAttributes":{},
			"x":-2040,
			"y":515,
			"width":400,
			"height":730
		},
		{
			"id":"53174f423773e9de",
			"type":"text",
			"text":"전 구간 트레이싱",
			"styleAttributes":{},
			"x":-2040,
			"y":1650,
			"width":260,
			"height":60
		},
		{"id":"aa6244babcffa863","type":"text","text":"<경로 B 전환>\nLibreOffice -> 전부 PDF 통일","x":270,"y":480,"width":250,"height":60},
		{
			"id":"4b1a6b73b5bedaf3",
			"type":"text",
			"text":"<PII 마스킹>\n전화, 이메일 정규식, Presido NER기반 개인정보 탐지 도구 \n(임베딩 전)",
			"styleAttributes":{},
			"x":-560,
			"y":540,
			"width":260,
			"height":130
		},
		{
			"id":"4351a88a1788efbc",
			"type":"text",
			"text":"<구조 기반 분할>\n섹션 헤더 1차 -> Recursive 2 차 ~ 500자, 오버랩 10-15%",
			"styleAttributes":{},
			"x":-600,
			"y":780,
			"width":340,
			"height":100
		},
		{
			"id":"8fa38ac044192d63",
			"type":"text",
			"text":"<컨텍스트 프리픽스 주입>\n사업명/발주기관/섹션 - 크레딧 비용 0",
			"styleAttributes":{},
			"x":-660,
			"y":1160,
			"width":300,
			"height":80
		},
		{
			"id":"eb60541e04d87757",
			"type":"text",
			"text":"<표 독립 청크>\nmarkdown 표 + 헤더 반복",
			"styleAttributes":{},
			"x":-430,
			"y":980,
			"width":260,
			"height":60
		},
		{
			"id":"5feb72ee6d92ca24",
			"type":"text",
			"text":"<4. 임베딩>\nmultilingual-e5-small\n(passage:)",
			"styleAttributes":{},
			"x":-640,
			"y":1340,
			"width":260,
			"height":100
		},
		{
			"id":"4b4d9e3e4fd4762e",
			"type":"text",
			"text":"<5. DB>\nChroma 청크 인덱스 + 문서카드(사업요약) 인덱스 + 메타데이터 필드",
			"styleAttributes":{"shape":"database"},
			"x":-640,
			"y":1560,
			"width":260,
			"height":180
		},
		{
			"id":"e21064d850778c82",
			"type":"text",
			"text":"라우터",
			"styleAttributes":{"shape":"diamond","textAlign":"center"},
			"x":-1255,
			"y":1510,
			"width":170,
			"height":100
		},
		{"id":"e0af893c32a76ce4","type":"text","text":"공통 Markdown + 문서ID,섹션,페이지 메타","x":-60,"y":40,"width":255,"height":60},
		{
			"id":"8432c489bfdf5d15",
			"type":"text",
			"text":"<메타데이터 정규화>\ndata_list.csv -> 금액, 날짜 파생컬럼 기관명 표준 사전 (NFC,NFD 아님)",
			"styleAttributes":{},
			"x":-860,
			"y":545,
			"width":260,
			"height":115
		},
		{
			"id":"d6a59e4a676825a4",
			"type":"text",
			"text":"<필터 + Top-k 검색>\nquery : 임베딩, where = 기관",
			"styleAttributes":{},
			"x":-1085,
			"y":1710,
			"width":260,
			"height":60
		},
		{
			"id":"f3af9952eecc9315",
			"type":"text",
			"text":"<메타 데이터 직답>\n예산, 마감일, 일정",
			"styleAttributes":{},
			"x":-1480,
			"y":1710,
			"width":260,
			"height":60
		},
		{
			"id":"aee5a269aa45c2eb",
			"type":"text",
			"text":"프롬프트 조립 -> gpt-5-mini -> 답변 + 출처",
			"styleAttributes":{},
			"x":-1125,
			"y":1880,
			"width":340,
			"height":60
		},
		{
			"id":"9a8c2072e0e1a07b",
			"type":"text",
			"text":"<텍스트 클리닝>\n줄바꿈, 목차, 반복 헤더 제거",
			"styleAttributes":{},
			"x":-560,
			"y":420,
			"width":260,
			"height":60
		}
