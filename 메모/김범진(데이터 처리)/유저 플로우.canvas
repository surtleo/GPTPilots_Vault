		},
		{
			"id":"09f85d7bd4abf69c",
			"type":"text",
			"text":"회사문서",
			"styleAttributes":{},
			"x":-440,
			"y":20,
			"width":260,
			"height":60
		},
		{
			"id":"0c59d4232206e949",
			"type":"text",
			"text":"1. 현재 정부 사업 rfp 탐색\n2. rfp 평가 보고서\n3. rfp 기본 요건 충족 확인\n4. 직접쓰기",
			"styleAttributes":{},
			"x":400,
			"y":-20,
			"width":260,
			"height":310
		},
		{
			"id":"ec2f24db66b24c59",
			"type":"text",
			"text":"rfp 우리회사 방향과 맞는것 추천해주기",
			"styleAttributes":{},
			"x":400,
			"y":-120,
			"width":260,
			"height":60
		},
