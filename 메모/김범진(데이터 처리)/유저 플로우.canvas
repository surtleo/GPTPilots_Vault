			"height":60
		},
		{
			"id":"c551f2034983eed6",
			"type":"text",
			"text":"1. 첫번째 사업",
			"styleAttributes":{},
			"x":1720,
			"y":140,
			"width":260,
			"height":60
		},
		{
			"id":"300e770e84c61024",
			"type":"text",
			"text":"2. 두번째 사업",
			"styleAttributes":{},
			"x":2040,
			"y":135,
			"width":260,
			"height":60
		},
		{
			"id":"f7a8f3a760a3de14",
			"type":"text",
			"text":"이것에대한 출처를 클릭하면 문서 다운받아짐. rfp문서. 사용자마다 저장소? 정부사업을 현재진행형중이다. 또는 그냥 리서치만함.",
			"styleAttributes":{},
			"x":1420,
			"y":-15,
			"width":260,
			"height":185
		},
		{
			"id":"1088d06ccee81242",
			"type":"text",
			"text":"현재 정부 사업 rfp를 탐색 top3",
